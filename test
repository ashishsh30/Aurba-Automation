def get_cfg_mode():
    if args.cfgmodlvl == 'device':
        if args.serial:
            result = api.GetDeviceCfgMode(args.serial)
        elif args.group:
            result = api.GetDevicesCfgModeInGrp(args.group)
        elif args.listofsns:
            sns = get_list_from_file(args.listofsns)
            result = []
            i = 0
            while i < len(sns):
                #comma seperated string of serials since that is what this api uses as input
                #the max number of serials it takes is 50, so get 50 at a time
                csvsns = ','.join(sns[i:i+49])
                logger.debug('csvsns: %s' %csvsns)
                r = api.GetDeviceCfgMode(csvsns)
                logger.debug(result)
                result += r
                i = i + 49
        else:
            logger.error('getconfigmode: Invalid usage, run -h for help')
            sys.exit(0)
        for r in result:
            logger.info('%s,%s' %(r['serial'], r['config_mode']))
    elif args.cfgmodlvl == 'group':
        if args.group:
            result = api.GetGroupCfgMode(group=args.group)
        elif not args.serial and not args.listofsns:
            #get all groups config mode 20 at a time
            result = api.GetGroupCfgMode()
