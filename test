def list_cmds():
    if args.devicetype == 'CXSWITCH':
        all_cmds = api.ListTsCmds(args.devicetype, serial=args.serial)
        logger.info(json.dumps(all_cmds, indent=4))
    else:
        all_cmds = api.ListTsCmds(args.devicetype)
        if args.search:
            for cmd in all_cmds['commands']:
                if args.search in cmd['command']:
                    logger.info('command: %s summary: %s command_id: %s' %(cmd['command'], cmd['summary'], cmd['command_id']))
        else:
            logger.info(json.dumps(all_cmds, indent=4))

def run_cmd():
    session = api.StartTsSession(args.serial, args.devicetype, command_id=args.cmdid, commands=args.cmd, name=args.arg1, value=args.value1)
    session_id = session.get('session_id')
    if session_id:
        results = api.GetTsOutput(args.serial, session_id)
        output = results.get('output')
        if output:
            output = output.splitlines()
            if args.search:
                pattern = '.*' + args.search + '.*'
                r = re.compile(pattern)
                newoutput = list(filter(r.match, output))
                newoutput_str = ','.join(newoutput)
                logger.info('%s, %s' %(args.serial, newoutput_str))
            else:
                logger.info('%s,%s' %(args.serial,json.dumps(output, indent=4)))
        else:
            logger.info('%s, %s, %s, Could not get troubleshooting output' %(args.serial, args.devicetype, args.cmdid))
    else:
        logger.info('%s, %s, %s, Could not start troubleshooting session' %(args.serial, args.devicetype, args.cmdid))

