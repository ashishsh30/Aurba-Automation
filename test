def backup_config():
    if args.group:
        result = api.GroupSnapshot(args.group, args.backupname)
        logger.info('%s,%s' %(args.group, result))
    elif args.listofgrps:
        groups = get_list_from_file(args.listofgrps)
        i = 0
        while i < len(groups):
            #list of groups since that is what this api uses as input
            #the max number of groups it takes is 50, so do 50 at a time
            logger.debug('groups: %s' %groups[i:i+49])
            r = api.MultiGroupSnapshot(groups[i:i+49], args.backupname)
            logger.debug(r)
            if r == 'Success':
                logger.info('%s,%s,Success' %(groups[i:i+49], args.backupname))
            else:
                logger.info(r)
            i = i + 49
    else:
        logger.info('Invalid usage, use -h for help.')

