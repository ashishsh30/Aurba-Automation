def get_list_from_file(input_file):
    mylist=[]
    try:
        f = open(input_file, 'r')
    except:
        logger.error('Could not open file: {0}'.format(input_file))
        sys.exit(1)
    else:
        for line in f:
            mylist.append(line.strip())
        f.close()
    return mylist


